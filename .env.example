# NEAR Testnet Configuration
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_CONTRACT_ID=
NEAR_RESOLVER_ACCOUNT_ID=
NEAR_RESOLVER_PRIVATE_KEY=

# NEAR AI Cloud (https://cloud.near.ai)
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
JURY_MODELS=deepseek-ai/DeepSeek-V4.1-Flash-1017,Qwen/Qwen3.6-35B-A3B-FP8,z-ai/glm-5.3-flash
PAGE_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
JURY_SUPERMAJORITY_NUMERATOR=2
JURY_SUPERMAJORITY_DENOMINATOR=3

# Offchain Services
PERPETUA_DB_PATH=./data/perpetua.db
SERVICES_PORT=3001
POLL_INTERVAL_MS=4000
AUTO_RUN_JURY=true
AUTO_GENERATE_PAGES=true
ALLOW_UNVERIFIED_FALLBACK=false
# Optional bearer token protecting POST /api/claims/:id/sync on public deployments
ADMIN_API_TOKEN=

# Frontend (Next.js)
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_SERVICES_URL=http://localhost:3001

# Phase 4 Stretch (NEAR Intents 1Click API - Mainnet only; dry=true on Testnet)
ONECLICK_API_BASE=https://1click.chaindefuser.com
ONECLICK_JWT=
