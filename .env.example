# NEAR Testnet Configuration
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_CONTRACT_ID=perpetua.testnet
NEAR_RESOLVER_ACCOUNT_ID=resolver.perpetua.testnet
NEAR_RESOLVER_PRIVATE_KEY=ed25519:REPLACE_WITH_TESTNET_RESOLVER_PRIVATE_KEY

# NEAR AI Cloud (https://cloud.near.ai)
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=REPLACE_WITH_NEAR_AI_API_KEY

# Offchain Services
PERPETUA_DB_PATH=./data/perpetua.db
SERVICES_PORT=3001
POLL_INTERVAL_MS=4000

# Frontend (Next.js)
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_CONTRACT_ID=perpetua.testnet
NEXT_PUBLIC_SERVICES_URL=http://localhost:3001

# Phase 4 Stretch (NEAR Intents 1Click API - Mainnet only; dry=true on Testnet)
ONECLICK_API_BASE=https://1click.chaindefuser.com
ONECLICK_JWT=

